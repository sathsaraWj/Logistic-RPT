# Copy to .env for local development. Never commit a real .env file (see .gitignore).
# No value in this file is a real credential.

ENVIRONMENT=local
SERVICE_NAME=hermes-rpt

# Control-plane database only — never a customer/tenant database (docs/ARCHITECTURE.md).
DATABASE_URL=postgresql+asyncpg://hermes:hermes@localhost:5432/hermes_control

LOG_LEVEL=INFO
LOG_JSON=true

MLFLOW_TRACKING_URI=http://localhost:5000

CORS_ALLOWED_ORIGINS=[]

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
